<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Foto do Aluno / Logotipo -->
        <ImageView
            android:id="@+id/imgAluno"
            android:layout_width="match_parent"
            android:layout_height="234dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sua_foto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🌎 Quiz das Bandeiras 🇧🇷"
            android:textColor="#1B1B1B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Campo real para o jogador digitar o nome (usado no ranking) -->
        <EditText
            android:id="@+id/edtNomeJogador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:hint="Digite seu nome para jogar"
            android:inputType="textPersonName"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1B1B1B"
            android:textColorHint="#9AA0AC"
            android:textSize="16sp" />

        <!-- Botão Iniciar -->
        <TextView
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_primario"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:text="INICIAR QUIZ"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Botão Sair -->
        <TextView
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_secundario"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="SAIR"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <!-- Card com os colaboradores do projeto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Colaboradores do Projeto 🇧🇷"
                android:textColor="#1B1B1B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="José Cauan Ferreira Da Silva - RGM: 42920949"
                android:textColor="#4B4F58"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kauã Bitencourt Da Paixão - RGM: 41900464"
                android:textColor="#4B4F58"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pedro Fidrlis Mandoti - RGM: 44069715"
                android:textColor="#4B4F58"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rafael Aparecido Zimbaldi Gomes - RGM: 43579621"
                android:textColor="#4B4F58"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Leonardo Soares Rocha - RGM: 044069154"
                android:textColor="#4B4F58"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Vinicius Custódio Pavan de Fatima - RGM: 44263465"
                android:textColor="#4B4F58"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
